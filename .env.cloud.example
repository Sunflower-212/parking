# Server credentials only. Generate .env with scripts/init-env.py --cloud.
# Fill every third-party credential, rotate the exposed Alipay app key, then run check-cloud-config.py.
# Resource limits are defined in compose.cloud.yml; editing unrelated .env values will not override them.
# Copy to .env; replace every replace-* value. Never commit .env.
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DB_PASSWORD=replace-with-strong-database-password
REDIS_PASSWORD=replace-with-strong-redis-password
CACHE_REDIS_PASSWORD=replace-with-strong-cache-password
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
RESERVATION_TIMEOUT=30m
PAYMENT_TIMEOUT=30m
AI_ENABLED=true
AI_AUTOCONFIG_EXCLUDE=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OCR_ENABLED=true
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
ALIPAY_ENABLED=true
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://60.205.230.175/parking/api/user/rechargeNotify
ALIPAY_RETURN_URL=http://60.205.230.175/parking/user/paymentResult
OSS_ENABLED=true
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
BACKGROUND_TASKS_ENABLED=true
# Must match capacity_settings; stop writers and run migration 006 before changing.
CAPACITY_BUCKETS=16
RABBITMQ_USER=parking
RABBITMQ_PASSWORD=replace-with-a-random-password
RABBITMQ_MANAGEMENT_PORT=15672

# Structured logs; runtime files and archives stay local.
APP_LOG_LEVEL=INFO
BUSINESS_LOG_LEVEL=INFO
REQUEST_LOG_ENABLED=true
SLOW_REQUEST_MS=500
READ_LOG_SAMPLE=0.1
