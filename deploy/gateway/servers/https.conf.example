# Copy to https.conf ONLY after replacing the domain and installing its certificate.
server {
    listen 443 ssl;
    server_name parking.example.com;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    include /etc/nginx/routes/*.conf;
    location / { return 404; }
}
