<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zjmproject.mapper.UserMapper">
    <!--动态sql-->
    <select id="pageListFind" resultType="org.zjmproject.pojo.User">
        select * from user
        <where>
            <if test="plateNum!=null">
                plate_num like concat('%',#{plateNum},'%')
            </if>
            <if test="carColor!=null">
                and car_color like concat('%',#{carColor},'%')
            </if>
            <if test="status!=null">
                and status=#{status}
            </if>
            <if test="userName!=null">
                and user_name like concat('%', #{userName}, '%')
            </if>
        </where>
    </select>

</mapper>
