# Copy to .env; replace every replace-* value. Never commit .env.
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DB_PASSWORD=replace-with-strong-database-password
REDIS_PASSWORD=replace-with-strong-redis-password
CACHE_REDIS_PASSWORD=replace-with-strong-cache-password
MYSQL_BUFFER_POOL_SIZE=1G
MYSQL_MAX_CONNECTIONS=100
DB_POOL_SIZE=20
PARKING_ADMISSION_PERMITS=8
CACHE_LOCAL_ENABLED=true
CACHE_LOCAL_TTL=1s
CACHE_LOCAL_WEIGHT_BYTES=16777216
MYSQL_MEMORY_LIMIT=2g
BACKEND_MEMORY_LIMIT=2g
REDIS_STATE_LIMIT=1536m
REDIS_CACHE_LIMIT=512m
FRONTEND_MEMORY_LIMIT=256m
REDIS_STATE_MEMORY=512mb
REDIS_CACHE_MEMORY=256mb
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
RESERVATION_TIMEOUT=30m
AI_ENABLED=false
AI_AUTOCONFIG_EXCLUDE=org.springframework.ai.autoconfigure.openai.OpenAiAutoConfiguration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OCR_ENABLED=false
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
OSS_ENABLED=false
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
BACKGROUND_TASKS_ENABLED=false
# Must match capacity_settings; stop writers and run migration 006 before changing.
CAPACITY_BUCKETS=16
RABBITMQ_USER=parking
RABBITMQ_PASSWORD=replace-with-a-random-password
RABBITMQ_MEMORY_LIMIT=512m
RABBITMQ_MANAGEMENT_PORT=15672

# Structured logs; runtime files and archives stay local.
APP_LOG_LEVEL=INFO
BUSINESS_LOG_LEVEL=INFO
REQUEST_LOG_ENABLED=true
SLOW_REQUEST_MS=500
READ_LOG_SAMPLE=0.1
LOG_MAX_FILE_SIZE=25MB
LOG_HISTORY_DAYS=14
LOG_TOTAL_SIZE_CAP=1GB
